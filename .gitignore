# Build outputs
/build*/
/out/
/cmake-build-*/
*.user
.vs/
.vscode/
.idea/

# Generated / local data
.bgmedia_cache/
*.bgm
*.bmp
*.png
!docs/images/*.png
!assets/**/*.png
/fixtures/
tests/fixtures/generated/
/artifacts/

# Private VRM assets. Model1.vrm and its textures are licensed for local use
# only (Redistribution_Prohibited / OnlyAuthor), so they must never be added
# to this repository. See models/README.md.
/models/*
!/models/README.md

# No private model, exported GLB or extracted texture directory may be
# committed from anywhere in the tree. The tests use a small, self-authored
# synthetic fixture; keep that one explicitly visible.
*.vrm
!tests/fixtures/minimal.vrm
*.glb
/model_textures/
/model_exports/
/artifacts/textures/

# Generated shader binaries; the C headers are committed and rebuilt from HLSL.
adapters/sdlgpu/shaders/generated/*.dxil
adapters/sdlgpu/shaders/generated/*.spv

# OS
.DS_Store
Thumbs.db
desktop.ini

# Root-level temporary dependency extraction
third_party/SDL3-*/
