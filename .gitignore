# Build outputs
/build*/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
*.user
.vs/
.vscode/
.idea/

# Generated / local data
.bgmedia_cache/
*.bgm
*.bmp
*.png
!docs/images/*.png
!assets/**/*.png
/fixtures/
tests/fixtures/generated/
/artifacts/

# Private VRM assets. Model1.vrm and its textures are licensed for local use
# only (Redistribution_Prohibited / OnlyAuthor), so they must never be added
# to this repository. See models/README.md.
/models/*
!/models/README.md

# No private model, exported GLB or extracted texture directory may be
# committed from anywhere in the tree. The tests use a small, self-authored
# synthetic fixture; keep that one explicitly visible.
*.vrm
!tests/fixtures/minimal.vrm
*.glb
/model_textures/
/model_exports/
/artifacts/textures/

# Generated shader binaries; the C headers are committed and rebuilt from HLSL.
adapters/sdlgpu/shaders/generated/*.dxil
adapters/sdlgpu/shaders/generated/*.spv

# Private music. The only committed audio is the synthetic decoder fixture;
# real tracks must stay local.
*.mp3
*.wav
*.flac
*.m4a
*.ogg
!tests/fixtures/decode_123.mp3
!tests/fixtures/decode_123.wav
!tests/fixtures/decode_123.flac

# Screen recordings / diagnostic video.
*.mp4
*.mov
*.webm
*.mkv

# Local archives and source dumps (BG Media.zip, src.zip, exports).
*.zip
*.7z
*.rar

# Secrets and local machine configuration.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json

# Python caches used by tools/dancegen.
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Scratch space for coding agents and ad-hoc diagnostics.
.cache/
.tmp/
*.tmp
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Root-level temporary dependency extraction
third_party/SDL3-*/
